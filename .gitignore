# ── Environment ──────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
.env
.DS_Store

# ── Model weights: large, re-downloadable. ──
# models/active.json is un-ignored because STUDENTS must commit theirs (rubric item 2).
# The template repo must NOT ship one, or verify.py passes the model check before the
# student has downloaded anything. If you are maintaining this repo: after `git add -A`,
# check `git ls-files models/` is empty before committing.
models/*
!models/active.json

# ── llama.cpp binaries: prebuilt (runtime/) and source build (bonus/). ──
# Both are re-fetchable via `make setup` / `make build-llama`. The grader
# does not need them, and `make verify` never asks for them.
runtime/
bonus/llama.cpp/

# ── Locust raw CSVs: load-report.py reads them, but only the generated
#    markdown + your screenshots are evidence. Keep the stats file so
#    `make load-report` is reproducible; drop the noisy per-request history.
benchmarks/locust-*_stats_history.csv
benchmarks/locust-*_failures.csv
benchmarks/locust-*_exceptions.csv

# ── TRACKED ON PURPOSE (do not add these) ────────────────────
#   hardware.json                    rubric item 1
#   models/active.json               rubric item 2
#   benchmarks/*.md, *.json          rubric items 3, 4, 5, 9, 10, 12, 13 + bonus
#   benchmarks/locust-*_stats.csv    input to `make load-report`
#   submission/**                    your report + screenshots
